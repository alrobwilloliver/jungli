# macOS
.DS_Store

# Local Claude Code settings (machine-specific, not shared)
.claude/settings.local.json

# Applicant PII — raw export + per-respondent detail. Keep local only.
# The sanitised, aggregates-only extract lives in source/survey-responses.md
source/*.xlsx
source/survey-respondents-private.md

# Generated slide exports (build from the .md with Marp; don't commit)
curriculum/teaching-pack/slides/*.html
curriculum/teaching-pack/slides/*.pdf

# Obsidian vault config (created when a vault folder is opened in Obsidian)
.obsidian/

# Node (for when the projects run)
node_modules/
.env
.env.local
